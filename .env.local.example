# Copy to .env.local. Deployment commands load it automatically (do not source it).
# Existing shell environment variables take precedence over this file.

# Your own authenticated AWS CLI profile (see docs/aws-setup.md).
AWS_PROFILE=camera-deploy
ASK_PROFILE=default

# Local Docker-host address, reachable from the computer running these commands.
SCRYPTED_HOST=192.168.1.100:10443

SKILL_NAME="My Scrypted Cameras"
# Fill from `npm run ask -- smapi get-vendor-list` for your selected ASK profile.
ALEXA_VENDOR_ID=
# Public Cloudflare Tunnel URL; this must NOT be the private Scrypted IP.
SCRYPTED_ENDPOINT=https://cameras.example.com/endpoint/scrypted-alexa-au/public/
CAMERA_LOGIN_EMAIL=

# Leave empty for a new skill. Creation saves the ID in config.local.json.
# Set only to use an existing skill; nonempty values override the saved ID.
ALEXA_SKILL_ID=
# Optional JSON array of exact callback URLs from the Alexa console.
# ALEXA_REDIRECT_URLS=["https://alexa.amazon.co.jp/api/skill/link/YOUR_VENDOR_ID"]

# AWS deployment region is intentionally fixed to us-west-2 for Australian Alexa.
# Do not put AWS access keys, Scrypted passwords, or tunnel tokens in this file.
